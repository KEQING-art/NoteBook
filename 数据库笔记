用户
创建新用户
create role 'user'@'localhost'

查看用户列表
SELECT User, Host FROM mysql.user;

查看自己现在是什么用户
select user();

修改用户密码
ALTER USER '用户名'@'主机' IDENTIFIED BY '新密码';

授予用户权限
GRANT SELECT（权限） ON 数据库名.表名 TO '用户名'@'主机'; //授予某用户单张表的查询权限 。 如果你把表名改为* ，意为将一个数据库的所有表的查询权限都给他了 ;若是你将数据库名改为*，那就意为将所有数据库的所有表的查询权限都给他了.
实例：GRANT CREATE, DROP, SELECT, INSERT ON studentsdb.* TO 'st_01'@'localhost'; 

授予一个角色另一个角色的权限
GRANT ROLE1 TO ROLE2 

撤销用户权限
revoke 权限 on 数据库.表 FROM 'user'@'host'
REVOKE CREATE, DROP, SELECT, INSERT ON studentsdb.* FROM 'st_01'@'localhost';

撤销一个角色的另一个角色的权限
REVOKE ROLE1 FROM ROLE2; 撤销role1 给 role2的权限

撤销用户的所有权限
REVOKE ALL PRIVILEGES, GRANT OPTION FROM 'st_01'@'localhost';

删除用户
DROP USER 'user'@'host'


刷新权限，是权限立即生效
FLUSH PRIVILEGES;
