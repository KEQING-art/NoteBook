二分查找可以解决有序字符串查找问题
  public static int find(ArrayList<String> array, String aim) {
    int left = 0;
    int right = array.size();
    while(left <= right){
      int mid = left + (right - left)/2;
      if(array.get(mid).compareTo(aim) == 0) {return mid;}
      else if(array.get(mid).compareTo(aim) < 0) {left = mid + 1;}
      else{right = mid - 1;}
    }
    return -1;
  }
