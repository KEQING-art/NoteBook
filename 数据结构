插入排序
public static void insertSort(int[] array)   //传入一个数组
for(int i = 1;i < array.length;i++){  //从一开始遍历
  int j = i - 1;
  int num = array[i];

while(j >= 0 &&  array[j] > num){  //边对比 ， 边位移
  array[j + 1] = array[j];
  j--;
}

array[j + 1] = num;  // 插入
}

冒泡排序
public static void Sort(int[] array) 
for(int i = 0;i < array.lenth - 1;i++){
  for(int j = i + 1;j < array.lenth;j ++){ 
     if(array[j] < array[i]) {array[j] += array[i]; array[i] = array[j] - array[i] ; array[j] -= array[i]}
  }
}

选择排序
public static void Sort(int[] array) 
for(int i = 0;i < array.lenth - 2;i++){
  int index = i;
  for(int j = i + 1;j < array.lenth;j ++){ 
     if(array[j] < array[i]) {index = j}
  }
  int temp ; temp = array[i]; array[i] = array[index] ; array[index] = temp; 
}

