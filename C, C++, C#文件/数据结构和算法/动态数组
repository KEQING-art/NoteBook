动态数组的实现
{////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
1 插入元素
public void add(int index, int element) {  这是一个通用的代码它可以在你任意想插入的位置插入
  if(index < 0 || index > this.size){return ;}
  for(int i = size;i > index;i--){
    array[i] = array[i - 1];
  }
  array[index] = element;
  size++;
  }

2
删除元素
  // 删除元素
  public void remove(int index) {
    for(int i = index + 1; i < size;i++){
      array[i - 1] = array[i];
    }
    size--;
  }

3
扩容
public static void grow(){
  if(this.size == array.length){
    int size = array.length * 2;
    int[] array1 = new int[size];
    System.arraycopy(array,0,array1,0,this.size);
    array = array1;
  }
} 扩容的核心就是制造一个新数组
}///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
