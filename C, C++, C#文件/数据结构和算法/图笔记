bool visited[MVNum]    //每个顶点初始都是false
void DFS(const Graph &G, int v){
  cout << v, visited[v] = true;
  for(int w = FirstAdjVex(G, v); w >= 0; w = NextAdjVex(G, v)){
    if(!visited[w]){
      DFS(G, w);
    }
  }
}
