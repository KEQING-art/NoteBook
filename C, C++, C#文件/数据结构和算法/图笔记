迪杰斯特拉算法
{/////////////////////////////////////////////////////////////////////////////////////////////////

D[G.vexnum] //记录源点到各顶点的最短距离
S[G.vexnum] //记录最短路径是否已确定
void ShortestPath_DIJ(AMGraph G,int v0){

  int n=G.vexnum,i,v,w,min;  //n 是G的顶点数。


  for(v=0; v<n; ++v) {
      S[v] = false;              // 所有人暂时都没毕业
      D[v] = G.arcs[v0][v];      // 先假设「直接边」就是最短距离
      if(D[v] < MaxInt) Path[v] = v0;  // v0 和 v 有直接边 → 前驱记 v0
      else              Path[v] = -1;   // 没有直接边 → 暂时不可达
  }
  S[v0] = true;   // 源点到自己距离 0，且一开始就确定
  D[v0] = 0;


  S[v0]=true; D[v0]=0;
  for(i=1;i<n;++i){
    min=MaxInt;
    for(w=0;w<n;++w)
      if(!S[w]&&D[w]<min){v=w;min=D[w];}
    S[v]=true;
    for(w=0;w<n;++w)
      if(!S[w]&&(D[v]+G.arcs[v][w]<D[w])){
        D[w]=D[v]+G.arcs[v][w]; Path[w]=v;
      }
  }
}
