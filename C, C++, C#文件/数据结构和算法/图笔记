无向图的临界多重表的存储结构
{/////////////////////////////////////////////////////////////////////////////////////////////////
理解多重表每条边只建立一个边节点，同时链接在两个端点的链表中。

C源码的弧存储结构
typedef struct EBox{
  VisitIf mark;               //标记该边是否被搜索过
  int ivex, jvex;             //两个端点的顶点下标。
  struct EBox *ilink, *jlink; //ilink指向依附ivex的下一条边, jlink指向依附jvex的下一条边
  InfoType *info;             //边的相关信息
}EBox;

C源码的顶点存储结构
typedef struct VexBox{
  VertexType data;            // 保存的数据
  EBox *firstedge;            // 指向依附该顶点的第一条边
}VexBox;

C源码的图存储结构
typedef struct {
  VexBox adjmulist[最大顶点数]; //图能存储的最大顶点数
  int vexnum, arcnum;          //图的顶点数, 弧数
}AMLGraph;
