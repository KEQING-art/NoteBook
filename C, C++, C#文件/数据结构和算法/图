BFS 遍历 
{/////////////////////////////////////////////////////////////////////////////////////////////////
C源码
void BFS(Graph G, int v){
  cout<<v; visited[v] = true;
  InitQueue(Q);  //初始化一个队列
  EnQueue(Q, v); //v 入队
  while(!QueueEmpty(Q)){
    DeQueue(Q, u);  // 取出队头元素, 置为u
    for(int w = FirstAdjVex(G, u); w>=0; w = NextAdjVex(G, u, w)){  //遍历这个元素的所有相连元素
      if(!visited[w]){
        cout<<w; visited[w] = true;
        EnQueue(Q, w); //v 入队
      }
    }
  }
}
