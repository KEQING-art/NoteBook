void DFS_AM(const AMGraph &G, int v){
  cout << G.vexs[v];
  visited[v] = true;
  for(int w = 0; w < G.vexnum; w++){
    if(G.arcs[v][w] && !visited[w]){
      DFS_AM(G, w);
    }
  }
}
