邻接表 DFS
{/////////////////////////////////////////////////////////////////////////////////////////////////
C源码
void DFS_AL(ALGraph &G, int v){
  cout << G.vertices[v].data;
  visited[v] = true;
  p = G.vertices[v].firstarc;
  while(p){
    w = p->adjvex;
    if(!visited[w]){
      DFS(G, w);
    }
    p  = p->nextarc;
  }
}
