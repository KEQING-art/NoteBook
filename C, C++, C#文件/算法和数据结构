void MergeList_L(LinkList &LA, LinkList &LB){ //这里的LA、LB是头节点， 我们假设头节点都存在。 
  node = LA;
  pc = LA;
  pa = LA->next;
  pb = LB->next;
  while(pa&&pb){
    if(pa->data > pb->data){
      pc->next = pb;
      pb = pb->next;
      pc = pc->next;
    }else{
      pc->next = pa;
      pa = pa->next;
      pc = pc->next;
    }
  }
  if(pa){
      pc->next = pa;
  }
  if(pb){
      pc->next = pb;
  }
  delete LB;
}
